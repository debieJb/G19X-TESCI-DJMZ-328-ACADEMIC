<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/_headInterno') %></head>
<body class="pagina-publica pagina-interna">
  <%- include('partials/_navegacionInterna', { seccion: 'panel' }) %>
  <main id="contenido" tabindex="-1">
    <h1>Bienvenido, <%= usuarioActual.nombre %></h1>
    <dl class="detalle">
      <div><dt>Nombre</dt><dd><%= usuarioActual.nombre %></dd></div>
      <div><dt>Email</dt><dd><%= usuarioActual.email %></dd></div>
      <div><dt>Rol</dt><dd><%= usuarioActual.rol %></dd></div>
      <% if (usuarioActual.empresa) { %><div><dt>Empresa</dt><dd><%= usuarioActual.empresa.nombre %></dd></div><% } %>
    </dl>
    <form action="/logout" method="post"><%- include('partials/_csrfLogout') %><button type="submit">Cerrar sesión</button></form>
  </main>
  <%- include('partials/_piePublico') %>
</body>
</html>
