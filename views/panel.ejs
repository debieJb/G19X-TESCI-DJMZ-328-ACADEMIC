<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | Marketing Automation</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="pagina-publica">
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <header class="encabezado"><div class="barra"><a class="marca" href="/">Marketing Automation</a></div></header>
  <main id="contenido" tabindex="-1">
    <h1>Bienvenido, <%= usuarioActual.nombre %></h1>
    <dl class="detalle">
      <div><dt>Nombre</dt><dd><%= usuarioActual.nombre %></dd></div>
      <div><dt>Email</dt><dd><%= usuarioActual.email %></dd></div>
      <div><dt>Rol</dt><dd><%= usuarioActual.rol %></dd></div>
      <% if (usuarioActual.empresa) { %><div><dt>Empresa</dt><dd><%= usuarioActual.empresa.nombre %></dd></div><% } %>
    </dl>
    <form action="/logout" method="post"><button type="submit">Cerrar sesión</button></form>
  </main>
  <%- include('partials/_piePublico') %>
</body>
</html>
