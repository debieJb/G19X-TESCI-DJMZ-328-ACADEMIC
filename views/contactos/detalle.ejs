<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= titulo %></title><link rel="stylesheet" href="/css/styles.css"></head>
<body><%- include('../partials/_encabezado', { seccion: 'contactos' }) %><main id="contenido" tabindex="-1">
<h1><%= contacto.nombre %></h1><section class="panel"><dl><dt>Email</dt><dd><%= contacto.email || 'Sin definir' %></dd><dt>Teléfono</dt><dd><%= contacto.telefono || 'Sin definir' %></dd><dt>Etiquetas</dt><dd><%= contacto.etiquetas.join(', ') || 'Sin etiquetas' %></dd><dt>Estado</dt><dd><%= contacto.activo ? 'Activo' : 'Inactivo' %></dd><dt>Canales habilitados</dt><dd><%= ['email', 'whatsapp', 'sms'].filter(canal => contacto.canales[canal]).join(', ') || 'Ninguno' %></dd><% if (usuarioActual.rol === 'superadmin') { %><dt>Empresa</dt><dd><%= contacto.empresa %></dd><% } %></dl></section>
<div class="acciones"><a class="boton editar" href="/contactos/<%= contacto._id %>/editar">Editar</a><a class="boton secundario" href="/contactos">Volver al listado</a></div>
<section class="seccion-admin"><h2>Eliminar contacto</h2><p>Esta acción elimina el contacto permanentemente.</p><form action="/contactos/<%= contacto._id %>/eliminar" method="post"><button class="boton eliminar" type="submit">Eliminar contacto</button></form></section>
</main></body></html>
