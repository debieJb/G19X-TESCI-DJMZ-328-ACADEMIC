    <% if (mensaje || Object.keys(errores).length) { %>
      <div class="aviso-error" role="alert"><%= mensaje || 'Corrige los campos indicados antes de guardar.' %></div>
    <% } %>
    <form class="formulario" action="<%= accion %>" method="post"><%- include('../partials/_csrfSuperadmin') %><%- include('../partials/_csrfCampana') %>
      <% if (accion === '/campanas' && usuarioActual.rol === 'superadmin') { %>
        <div class="campo campo-amplio"><label for="empresa">Empresa propietaria</label>
          <select id="empresa" name="empresa" required aria-describedby="empresa-error"><option value="">Selecciona una empresa</option>
            <% for (const empresa of (typeof empresasDisponibles !== 'undefined' ? empresasDisponibles : [])) { %><option value="<%= empresa._id %>" <%= datos.empresa === String(empresa._id) ? 'selected' : '' %>><%= empresa.nombre %></option><% } %>
          </select><span class="error-campo" id="empresa-error"><%= errores.empresa || '' %></span>
        </div>
      <% } %>
      <p>Nombre y objetivo son obligatorios. La fecha de inicio es obligatoria para una campaña programada. La fecha de fin es opcional. El envío utiliza Gmail y n8n. Los cambios de estado son manuales.</p>
      <% for (const [campo, etiqueta] of [['nombre', 'Nombre'], ['objetivo', 'Objetivo']]) { %>
        <div class="campo campo-amplio">
          <label for="<%= campo %>"><%= etiqueta %> (obligatorio)</label>
          <% if (campo === 'objetivo') { %>
            <textarea id="<%= campo %>" name="<%= campo %>" required rows="4" aria-invalid="<%= !!errores[campo] %>" aria-describedby="<%= campo %>-error"><%= datos[campo] %></textarea>
          <% } else { %>
            <input id="<%= campo %>" name="<%= campo %>" value="<%= datos[campo] %>" required aria-invalid="<%= !!errores[campo] %>" aria-describedby="<%= campo %>-error">
          <% } %>
          <span class="error-campo" id="<%= campo %>-error"><%= errores[campo] || '' %></span>
        </div>
      <% } %>
      <div class="campo">
        <% if (accion === '/campanas') { %>
          <p>Estado inicial: Borrador</p>
        <% } else if (estadoActual === 'finalizada') { %>
          <p>Estado: Finalizada. Esta campaña no puede volver a otro estado.</p>
          <input type="hidden" name="estado" value="finalizada">
        <% } else { %>
          <p>Estado actual: <%= estados[estadoActual] || 'No disponible' %></p>
          <label for="estado">Estado al guardar</label>
          <select id="estado" name="estado" required aria-invalid="<%= !!errores.estado %>" aria-describedby="estado-error">
            <% if (!estadosPermitidos.includes(datos.estado)) { %><option value="" selected>Selecciona un estado permitido</option><% } %>
            <% for (const estado of estadosPermitidos) { %>
              <option value="<%= estado %>" <%= datos.estado === estado ? 'selected' : '' %>><%= estados[estado] %></option>
            <% } %>
          </select>
        <% } %>
        <span class="error-campo" id="estado-error"><%= errores.estado || '' %></span>
      </div>
      <p>Canal: <%= datos.canal === 'email' ? 'Correo electrónico (Gmail)' : 'Canal descontinuado' %></p>
      <input id="canal" type="hidden" value="<%= datos.canal === 'email' ? 'email' : 'descontinuado' %>">
      <span class="error-campo" id="canal-error"><%= errores.canal || '' %></span>
      <% for (const [campo, etiqueta] of [['fechaInicio', 'Fecha de inicio'], ['fechaFin', 'Fecha de fin']]) { %>
        <div class="campo">
          <label for="<%= campo %>"><%= etiqueta %> (<%= campo === 'fechaInicio' ? 'obligatoria si está programada' : 'opcional' %>)</label>
          <input type="<%= errores[campo] ? 'text' : 'date' %>" id="<%= campo %>" name="<%= campo %>" value="<%= datos[campo] %>" placeholder="AAAA-MM-DD" aria-invalid="<%= !!errores[campo] %>" aria-describedby="<%= campo %>-error">
          <span class="error-campo" id="<%= campo %>-error"><%= errores[campo] || '' %></span>
        </div>
      <% } %>
      <section id="contenido-email" class="campo-amplio" <%= datos.canal === 'email' ? '' : 'hidden' %>>
      <p>Contenido para el canal email. Puedes guardarlo incompleto; asunto y mensaje son obligatorios para ejecutar el envío.</p>
      <% for (const [campo, etiqueta] of [['asunto', 'Asunto'], ['cuerpoTexto', 'Mensaje']]) { %>
        <div class="campo campo-amplio">
          <label for="<%= campo %>"><%= etiqueta %> (solo email)</label>
          <% if (campo === 'cuerpoTexto') { %>
            <textarea id="<%= campo %>" name="<%= campo %>" rows="8" aria-invalid="<%= !!errores[campo] %>" aria-describedby="<%= campo %>-error"><%= datos[campo] || '' %></textarea>
          <% } else { %>
            <input id="<%= campo %>" name="<%= campo %>" value="<%= datos[campo] || '' %>" aria-invalid="<%= !!errores[campo] %>" aria-describedby="<%= campo %>-error">
          <% } %>
          <span class="error-campo" id="<%= campo %>-error"><%= errores[campo] || '' %></span>
        </div>
      <% } %>
      </section>
      <% if (datos.canal === 'email') { %><%- include('_destinatarios') %><% } %>
      <div class="acciones"><button type="submit">Guardar campaña</button><a class="boton secundario" href="<%= cancelar %>">Cancelar</a></div>
    </form>
    <script src="/js/campanaFormulario.js" defer></script>
    <script src="/js/destinatariosFormulario.js" defer></script>
