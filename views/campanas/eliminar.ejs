<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/_headInterno') %></head>
<body class=" pagina-interna">
  <%- include('../partials/_encabezado', { seccion: 'campanas' }) %>
  <main id="contenido" tabindex="-1" class="zona-peligro">
    <h1><%= titulo %></h1>
    <p>Vas a eliminar la campaña <strong><%= campana.nombre %></strong>.</p>
    <p>Esta acción es permanente y no se puede deshacer.</p>
    <% if (mensaje) { %><p class="aviso-error" role="alert"><%= mensaje %></p><% } %>
    <form action="/campanas/<%= campana._id %>/eliminar" method="post"><%- include('../partials/_csrfSuperadmin') %><%- include('../partials/_csrfCampana') %>
      <label class="confirmacion"><input type="checkbox" name="confirmacion" value="eliminar" required> Confirmo que quiero eliminar esta campaña.</label>
      <div class="acciones">
        <button class="peligro" type="submit">Eliminar definitivamente</button>
        <a class="boton secundario" href="/campanas/<%= campana._id %>">Cancelar</a>
      </div>
    </form>
  </main>
<%- include('../partials/_piePublico') %></body>
</html>
