<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/campanas">Campañas</a></nav>
    <h1><%= campana.nombre %></h1>
    <dl class="detalle">
      <dt>Objetivo</dt><dd><%= campana.objetivo %></dd>
      <dt>Canal</dt><dd><%= canales[campana.canal] || 'Sin definir' %></dd>
      <dt>Estado</dt><dd><%= estados[campana.estado] || 'Sin definir' %></dd>
      <dt>Fecha de inicio</dt><dd><%= formatearFecha(campana.fechaInicio) %></dd>
      <dt>Fecha de fin</dt><dd><%= formatearFecha(campana.fechaFin) %></dd>
      <dt>Fecha de creación (UTC)</dt><dd><%= formatearFecha(campana.createdAt) %></dd>
      <dt>Última actualización (UTC)</dt><dd><%= formatearFecha(campana.updatedAt) %></dd>
    </dl>
    <nav aria-label="Acciones de campaña">
      <a class="boton" href="/campanas/<%= campana._id %>/editar">Editar</a>
      <a href="/campanas/<%= campana._id %>/eliminar">Eliminar</a>
      <a href="/campanas">Volver al listado</a>
    </nav>
  </main>
</body>
</html>
