<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/_encabezado', { seccion: 'campanas' }) %>
  <main id="contenido" tabindex="-1">
    <h1><%= campana.nombre %></h1>
    <% if (mensaje) { %>
      <p class="<%= errorAutomatizacion ? 'aviso-error' : 'panel' %>" role="<%= errorAutomatizacion ? 'alert' : 'status' %>"><%= mensaje %></p>
    <% } %>
    <% if (campana.estado === 'finalizada') { %><p>Esta campaña está finalizada y no puede volver a otro estado.</p><% } %>
    <dl class="detalle">
      <div class="objetivo"><dt>Objetivo</dt><dd><%= campana.objetivo %></dd></div>
      <div><dt>Canal</dt><dd><%= canales[campana.canal] || 'Sin definir' %></dd></div>
      <% if (campana.canal === 'email') { %>
        <div><dt>Asunto</dt><dd><%= campana.asunto || 'Sin definir' %></dd></div>
        <div class="objetivo"><dt>Mensaje</dt><dd style="white-space: pre-wrap; overflow-wrap: anywhere;"><%= campana.cuerpoTexto || 'Sin definir' %></dd></div>
      <% } %>
      <% if (campana.canal === 'redes_sociales') { %>
        <div class="objetivo"><dt>Publicación</dt><dd><%= campana.publicacion || 'Sin definir' %></dd></div>
      <% } %>
      <div><dt>Estado</dt><dd><span class="insignia estado-<%= campana.estado %>"><%= estados[campana.estado] || 'Sin definir' %></span></dd></div>
      <div><dt>Fecha de inicio</dt><dd><%= formatearFecha(campana.fechaInicio) %></dd></div>
      <div><dt>Fecha de fin</dt><dd><%= formatearFecha(campana.fechaFin) %></dd></div>
      <div><dt>Fecha de creación (UTC)</dt><dd><%= formatearFecha(campana.createdAt) %></dd></div>
      <div><dt>Última actualización (UTC)</dt><dd><%= formatearFecha(campana.updatedAt) %></dd></div>
    </dl>
    <% if (mensajeCanal) { %>
      <p class="panel" role="status"><%= mensajeCanal %></p>
    <% } else if (campana.estado === 'activa') { %>
      <form action="/campanas/<%= campana._id %>/ejecutar" method="post">
        <button type="submit">Ejecutar automatización</button>
      </form>
    <% } %>
    <nav aria-label="Acciones de campaña">
      <a class="boton editar" href="/campanas/<%= campana._id %>/editar">Editar</a>
      <a class="boton eliminar" href="/campanas/<%= campana._id %>/eliminar">Eliminar</a>
      <a href="/campanas">Volver al listado</a>
    </nav>
  </main>
</body>
</html>
