<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <nav aria-label="Navegación principal"><a href="/">Inicio</a></nav>
    <h1><%= titulo %></h1>
    <p><a class="boton" href="/campanas/nueva">Crear campaña</a></p>
    <% if (!campanas.length) { %>
      <p>Aún no hay campañas. Crea la primera para comenzar.</p>
    <% } else { %>
      <div class="tabla-contenedor" role="region" aria-label="Listado de campañas" tabindex="0">
        <table>
          <caption>Campañas, de la más reciente a la más antigua</caption>
          <thead><tr><th scope="col">Nombre</th><th scope="col">Objetivo</th><th scope="col">Canal</th><th scope="col">Estado</th><th scope="col">Inicio</th><th scope="col">Fin</th><th scope="col">Acciones</th></tr></thead>
          <tbody>
            <% for (const campana of campanas) { %>
              <tr>
                <td><%= campana.nombre %></td>
                <td><%= campana.objetivo %></td>
                <td><%= canales[campana.canal] || 'Sin definir' %></td>
                <td><%= estados[campana.estado] || 'Sin definir' %></td>
                <td><%= formatearFecha(campana.fechaInicio) %></td>
                <td><%= formatearFecha(campana.fechaFin) %></td>
                <td><nav aria-label="Acciones de <%= campana.nombre %>">
                  <a href="/campanas/<%= campana._id %>">Detalle</a>
                  <a href="/campanas/<%= campana._id %>/editar">Editar</a>
                  <a href="/campanas/<%= campana._id %>/eliminar">Eliminar</a>
                </nav></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
