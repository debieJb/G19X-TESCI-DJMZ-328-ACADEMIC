<div class="campo">
  <label for="<%= id %>"><%= etiqueta %></label>
  <div class="entrada-password">
    <%- include('_icono', { nombre: 'candado' }) %>
    <input id="<%= id %>" name="<%= nombre %>" type="password" autocomplete="<%= nuevo ? 'new-password' : 'current-password' %>" required
      <%- nuevo ? 'minlength="16" data-password-new' : '' %> data-max-bytes="72" <%- typeof ayuda !== 'undefined' && ayuda ? 'aria-describedby="password-ayuda"' : '' %>>
    <button type="button" class="mostrar-password" data-toggle-password aria-controls="<%= id %>" aria-pressed="false" hidden>Mostrar<span class="solo-lectores">: <%= etiqueta %></span></button>
  </div>
</div>
