    <a class="marca" href="/" aria-label="Marketing Automation de PluriOne, inicio"><span class="marca-icono" aria-hidden="true">P.</span><span>Marketing Automation<small>POR PLURIONE</small></span></a>
    <button class="menu-publico" type="button" data-menu-toggle aria-expanded="false" aria-controls="navegacion-publica" hidden>Menú <span aria-hidden="true">☰</span></button>
    <nav id="navegacion-publica" aria-label="Navegación pública"><a href="/#funcionalidades">Producto</a><a href="/#como-funciona">Cómo funciona</a>
      <% if (typeof usuarioActual !== 'undefined' && usuarioActual) { %>
        <div class="identidad-publica"><%- include('_identidadUsuario') %></div>
        <a class="boton" href="/panel">Ir a mi panel</a>
        <%- include('_cerrarSesion') %>
      <% } else { %><a href="/registro">Registrar empresa</a><a class="boton" href="/login">Iniciar sesión</a><% } %>
    </nav>
  </div>
</header>
