<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | Marketing Automation</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="pagina-publica">
  <%- include('partials/_encabezadoPublico') %>
  <main class="acceso-publico" id="contenido" tabindex="-1">
    <section class="panel tarjeta-acceso" aria-labelledby="titulo-login">
      <p class="sobrelinea">Tu espacio de marketing</p>
      <h1 id="titulo-login">Iniciar sesión</h1>
      <p class="intro">Accede a tu espacio de trabajo.</p>
      <% if (error) { %><p class="aviso-error" role="alert"><%= error %></p><% } %>
      <form class="campos-acceso" action="/login" method="post" aria-labelledby="titulo-login">
        <div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" placeholder="tu@empresa.com" required></div>
        <div class="campo"><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Tu contraseña" required></div>
        <button type="submit">Iniciar sesión</button>
      </form>
      <p><a href="/registro">Registrar mi empresa</a></p>
      <a class="volver-inicio" href="/">← Volver al inicio</a>
    </section>
  </main>
  <%- include('partials/_piePublico') %>
</body>
</html>
