<!DOCTYPE html>
<html lang="es"><head><%- include('../partials/_headInterno') %></head>
<body class="pagina-admin pagina-interna"><%- include('../partials/_encabezado', { seccion: '' }) %>
<main id="contenido" tabindex="-1">
<h1>Nuevo operador</h1><p>Empresa: <%= usuarioActual.empresa.nombre %></p>
<% if (errores.length) { %><div class="aviso-error" role="alert"><% for (const error of errores) { %><p><%= error %></p><% } %></div><% } %>
<form action="/empresa/usuarios" method="post" class="formulario">
<%- include('../partials/_csrfCampana') %>
<div class="campo"><label for="nombre">Nombre</label><input id="nombre" name="nombre" required value="<%= datos.nombre %>"></div>
<div class="campo"><label for="email">Email</label><input id="email" name="email" type="email" required value="<%= datos.email %>"></div>
<div class="campo campo-amplio"><label for="password">Contraseña</label><input id="password" name="password" type="password" required autocomplete="new-password"><p>Máximo 72 bytes.</p></div>
<div class="acciones"><button type="submit">Crear operador</button><a href="/panel">Cancelar</a></div></form>
</main><%- include('../partials/_piePublico') %></body></html>
