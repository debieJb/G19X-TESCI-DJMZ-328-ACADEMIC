<section class="seccion-admin"><h2>Campañas de tu empresa</h2>
<a class="boton" href="/campanas/nueva">Crear campaña</a>
<a class="boton secundario" href="/empresa/ia">Crear campaña con IA</a>
<p class="nota-disponibilidad">La asistencia Gemini y el envío real requieren activación y validación. Preparar una campaña no envía mensajes.</p>
<% if (!campanas.length) { %><p>No hay campañas registradas</p><% } else { %>
<div class="tabla-admin" role="region" aria-label="Campañas de tu empresa" tabindex="0"><table><caption>Campañas</caption><thead><tr><th>Nombre</th><th>Canal</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<% for (const campana of campanas) { %><tr><td><%= campana.nombre %></td><td><%= campana.canal === 'email' ? 'Correo electrónico (Gmail)' : 'Canal fuera del MVP actual' %></td><td><%= campana.estado %></td><td>
<a href="/campanas/<%= campana._id %>">Consultar</a> · <a href="/campanas/<%= campana._id %>/editar">Editar</a>
<% if (campana.estado === 'borrador') { %><a href="/campanas/<%= campana._id %>/automatizacion">Configurar automatización</a><% } %>
<% if (campana.estado === 'activa' && campana.canal === 'email' && campana.versionFlujo !== 2 && !campana.asistenciaIA && !campana.automatizacion) { %><form action="/campanas/<%= campana._id %>/ejecutar" method="post"><%- include('../partials/_csrfCampana') %><label><input type="checkbox" name="confirmacion" value="ENVIAR" required>Confirmo el envío real</label><button type="submit">Ejecutar campaña</button></form><% } %>
</td></tr><% } %></tbody></table></div><% } %></section>
