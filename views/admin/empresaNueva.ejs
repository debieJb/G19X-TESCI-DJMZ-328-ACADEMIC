<!DOCTYPE html>
<html lang="es">
<head><%- include('../partials/_headInterno') %></head>
<body class="pagina-admin pagina-interna">
  <%- include('../partials/_encabezadoAdmin', { seccionAdmin: 'empresas' }) %>
  <main id="contenido" tabindex="-1">
    <div class="formulario-pagina">
      <p class="sobrelinea">Administración / Empresas</p><h1>Nueva empresa</h1>
      <%- include('../partials/_validacionServidor') %>
      <form action="/admin/empresas" method="post" class="formulario"><%- include('../partials/_csrfSuperadmin') %>
        <div class="campo"><label for="nombre">Nombre</label><input id="nombre" name="nombre" value="<%= datos.nombre %>" required></div>
        <div class="campo"><label for="estado">Estado</label><select id="estado" name="estado" required><option value="">Selecciona un estado</option><% for (const estado of ['activa', 'inactiva']) { %><option value="<%= estado %>" <%= datos.estado === estado ? 'selected' : '' %>><%= estado %></option><% } %></select></div>
        <div class="acciones"><button type="submit">Crear empresa</button><a href="/panel">Cancelar</a></div>
      </form>
    </div>
  </main>
  <%- include('../partials/_piePublico') %>
</body>
</html>
