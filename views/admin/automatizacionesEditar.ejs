<!DOCTYPE html>
<html lang="es"><head><%- include('../partials/_headInterno') %></head>
<body class="pagina-admin pagina-interna"><%- include('../partials/_encabezadoAdmin', { seccionAdmin: 'empresas' }) %>
<main id="contenido" tabindex="-1">
<h1>Automatizaciones de <%= empresa.nombre %></h1>
<p>Configuración del contrato histórico de webhooks, cuyo envío permanece bloqueado. El motor actual de Gmail API no necesita estas URLs. Deshabilitar conserva el bloqueo del canal.</p>
<% if (error) { %><p class="aviso-error" role="alert"><%= error %></p><% } %>
<form action="/admin/empresas/<%= empresa._id %>/automatizaciones" method="post" class="formulario"><%- include('../partials/_csrfSuperadmin') %>
<% for (const canal of canales) { const config = empresa.automatizaciones?.[canal]; %>
<section class="campo-amplio"><h2><%= 'Correo electrónico (Gmail)' %></h2>
<div class="campo"><label for="<%= canal %>Habilitada">Estado</label><select id="<%= canal %>Habilitada" name="<%= canal %>Habilitada">
<option value="true" <%= (config?.habilitada ?? (canal === 'email')) ? 'selected' : '' %>>Habilitada</option><option value="false" <%= !(config?.habilitada ?? (canal === 'email')) ? 'selected' : '' %>>Deshabilitada</option></select></div>
<div class="campo"><label for="<%= canal %>WebhookUrl">Webhook URL (opcional)</label><input id="<%= canal %>WebhookUrl" name="<%= canal %>WebhookUrl" type="url" autocomplete="off" value="<%= config?.webhookUrl || '' %>"></div>
</section><% } %><div class="acciones"><button type="submit">Guardar configuración</button><a class="boton secundario cancelar" href="/admin/empresas/<%= empresa._id %>">Cancelar</a></div></form>
</main><%- include('../partials/_piePublico') %></body></html>
