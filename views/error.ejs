<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('partials/_encabezado', { seccion: '' }) %>
  <main id="contenido" tabindex="-1" class="pagina-error panel">
    <h1><%= titulo %></h1>
    <p class="aviso-error" role="alert"><%= mensaje %></p>
    <nav aria-label="Navegación">
      <% if (usuarioActual) { %>
        <a href="/campanas">Volver al listado</a><a href="/panel">Mi panel</a>
      <% } else { %>
        <a href="/login">Iniciar sesión</a><a href="/">Volver al inicio</a>
      <% } %>
    </nav>
  </main>
</body>
</html>
