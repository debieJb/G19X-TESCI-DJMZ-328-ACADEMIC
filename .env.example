
# ============================================================
# PLURIONE - PLATAFORMA INTELIGENTE DE MARKETING AUTOMATION
# Archivo: .env.example
#
# Plantilla pública de configuración para desarrollo.
# Copiar a .env y configurar valores privados.
#
# IMPORTANTE:
# - No introducir contraseñas ni tokens reales aquí.
# - No publicar el archivo .env.
# - No activar proveedores externos sin configurarlos.
# ============================================================


# ------------------------------------------------------------
# 1. CONFIGURACIÓN GENERAL
# ------------------------------------------------------------

# Entorno: development para pruebas locales.
NODE_ENV=development

# Puerto del servidor Express.
PORT=3000

# MongoDB: usar una base propia en un replica set preparado.
# Requiere PRIMARY y soporte de transacciones.
# Ejemplo de desarrollo: marketingDevRs en el puerto 27018.
# No utilizar bases de producción para ejecutar pruebas.
MONGODB_URI=mongodb://127.0.0.1:27018/marketing_automation?replicaSet=marketingDevRs


# ------------------------------------------------------------
# 2. SEGURIDAD Y SESIONES
# ------------------------------------------------------------

# OBLIGATORIO:
# Secreto aleatorio y privado para firmar las sesiones.
# Generar uno nuevo, de al menos 32 bytes aleatorios.
# No reutilizar la clave de otros entornos.
SESSION_SECRET=


# ------------------------------------------------------------
# 3. SUPERADMINISTRADOR INICIAL
# ------------------------------------------------------------

# Se utilizan con:
# npm run crear-superadmin
#
# El script crea el usuario inicial con:
# - rol: superadmin
# - estadoAcceso: activo
# - contraseña protegida mediante bcrypt
#
# Si el correo ya existe, no modifica esa cuenta.
# La contraseña no debe superar 72 bytes UTF-8.

SUPERADMIN_NOMBRE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=


# ------------------------------------------------------------
# 4. N8N - COMPATIBILIDAD HISTÓRICA
# ------------------------------------------------------------

# Webhook del flujo antiguo.
# No es necesario para el motor Gmail API actual.
# Configurar esta URL no habilita envíos.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/campana

# Tiempo máximo de espera del webhook en milisegundos.
N8N_WEBHOOK_TIMEOUT_MS=10000


# ------------------------------------------------------------
# 5. GMAIL OAUTH EMPRESARIAL
# ------------------------------------------------------------

# Credenciales de una aplicación OAuth en Google Cloud.
# Cada empresa autoriza su propia cuenta Gmail.
#
# No publicar Client Secret, tokens o credenciales.
# La URI de redirección debe coincidir exactamente
# con la registrada en Google Cloud.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/empresa/gmail/callback

# Clave para cifrar tokens OAuth empresariales.
# Requiere 32 bytes aleatorios codificados en base64.
# Es independiente de SESSION_SECRET.
GMAIL_TOKEN_ENCRYPTION_KEY=


# ------------------------------------------------------------
# 6. MOTOR DE CAMPAÑAS GMAIL
# ------------------------------------------------------------

# Mantener deshabilitado durante la instalación inicial.
GMAIL_CAMPAIGNS_ENABLED=false

# Modos admitidos por el proyecto:
#
# piloto:
#   Prueba histórica de un destinatario.
#
# manual:
#   Modo manual histórico de un destinatario.
#
# supervisado:
#   Permite varios destinatarios con revisión
#   y confirmación explícita.
#
# automatico:
#   Utiliza un trabajador automático.
#   No usar sin preparar su infraestructura.
#
# Para comenzar de forma controlada:
GMAIL_CAMPAIGNS_MODE=piloto

# Cantidad máxima de destinatarios.
# El piloto inicial utiliza 1.
# La ampliación requiere configuración y autorización.
GMAIL_CAMPAIGNS_MAX_RECIPIENTS=1

# IDs MongoDB de empresas autorizadas.
# Separar múltiples identificadores con comas.
# No utilizar nombres ni correos de empresas.
GMAIL_CAMPAIGNS_PILOT_COMPANIES=

# Política del modo manual histórico.
# Ver documentación antes de modificar.
GMAIL_CAMPAIGNS_MANUAL_POLICY=


# ------------------------------------------------------------
# 7. INTELIGENCIA ARTIFICIAL - GEMINI
# ------------------------------------------------------------

# Activar únicamente después de configurar
# un modelo y una clave API válidos.
AI_ENABLED=false

# Proveedor implementado.
AI_PROVIDER=gemini

# Nombre de un modelo disponible para la API.
# Consultar la documentación de Google AI Studio.
# No fijar un modelo sin verificar su disponibilidad.
AI_MODEL=

# Confirmar solo si las condiciones de gratuidad
# y facturación aplicables fueron verificadas.
AI_FREE_TIER_CONFIRMED=false

# Clave privada de Gemini.
GEMINI_API_KEY=


# ------------------------------------------------------------
# 8. CORREO TRANSACCIONAL DE PLATAFORMA
# ------------------------------------------------------------

# Correo utilizado para verificar registros
# empresariales y operaciones de la plataforma.
#
# Es independiente del Gmail OAuth empresarial.
# Mantener deshabilitado hasta configurar SMTP.
TRANSACTIONAL_EMAIL_ENABLED=false

# Trabajador de correos transaccionales.
TRANSACTIONAL_WORKER_ENABLED=false

# Intervalo de revisión en milisegundos.
TRANSACTIONAL_WORKER_POLL_MS=2000

# Límites operativos de envío.
TRANSACTIONAL_SENDS_PER_MINUTE=10
TRANSACTIONAL_SENDS_PER_DAY=100

# SMTP con Gmail.
# EMAIL_USER: cuenta remitente.
# EMAIL_PASS: contraseña de aplicación.
# No utilizar la contraseña habitual de Gmail.
EMAIL_USER=
EMAIL_PASS=

# Origen público para los enlaces de verificación.
#
# Desarrollo:
# http://localhost:3000
#
# Producción:
# Utilizar HTTPS y el dominio real del servidor.
TRANSACTIONAL_PUBLIC_ORIGIN=http://localhost:3000

# Rutas locales: exportar tambien en la sesion PowerShell/Node.
# Los scripts de infraestructura no cargan este archivo.
PLURIONE_MONGO_DEV_ROOT=../marketing-automation-dev-mongo-rs
PLURIONE_MONGO_PILOT_ROOT=../marketing-automation-pilot-mongo-rs
PLURIONE_MONGO_QUOTA_ROOT=../marketing-automation-cuota-mongo
PLURIONE_MONGO_GEMINI_ROOT=../marketing-automation-cuota-mongo-gemini
# Vacio: buscar en PATH. Ruta absoluta o relativa al repositorio.
PLURIONE_MONGOD_PATH=
PLURIONE_MONGOSH_PATH=

# Opcional: navegador ya instalado para pruebas visuales explicitas.
PUBLIC_BROWSER_EXECUTABLE=
