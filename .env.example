NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/marketing_automation
PORT=3000

# Generar fuera del repositorio; producción exige al menos 32 bytes aleatorios.
# El almacén persistente y trust proxy requieren integración de infraestructura;
# consultar docs/sesiones-produccion.md. No se habilitan con esta plantilla.
SESSION_SECRET=

SUPERADMIN_NOMBRE=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

N8N_WEBHOOK_URL=http://localhost:5678/webhook/campana
N8N_WEBHOOK_TIMEOUT_MS=10000

# Gmail OAuth: credenciales reales solo en .env; clave de 32 bytes en base64.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/empresa/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=

# Motor oficial Gmail API. No habilitar hasta confirmar la prueba controlada.
# supervisado: varios destinatarios, confirmación explícita y sin trabajador.
# manual/piloto: piloto histórico de un destinatario.
# automatico: inicia trabajador con el servidor; no usar para la entrega supervisada.
GMAIL_CAMPAIGNS_MODE=piloto
GMAIL_CAMPAIGNS_ENABLED=false
# Un destinatario por defecto. Aumentar hasta 50 solo con autorización adicional.
GMAIL_CAMPAIGNS_MAX_RECIPIENTS=1
# IDs Mongo de empresas autorizadas por despliegue, separados por comas.
GMAIL_CAMPAIGNS_PILOT_COMPANIES=
# Solo para el piloto manual histórico: por_campana admite campañas sucesivas.
# El modo supervisado tiene ejecuciones independientes y no consume ese control.
GMAIL_CAMPAIGNS_MANUAL_POLICY=

# IA opcional: deshabilitada hasta autorizar clave/modelo sin facturación.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_FREE_TIER_CONFIRMED=false
AI_MODEL=
GEMINI_API_KEY=
# Remitente transaccional de plataforma: independiente del Gmail empresarial.
# Mantener false hasta autorizar expresamente una prueba real.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_WORKER_ENABLED=false
TRANSACTIONAL_WORKER_POLL_MS=2000
TRANSACTIONAL_SENDS_PER_MINUTE=10
TRANSACTIONAL_SENDS_PER_DAY=100
# SMTP exclusivo de la plataforma: Gmail con contraseña de aplicación (no contraseña habitual).
# No se utilizan estas variables para campañas empresariales.
EMAIL_USER=
EMAIL_PASS=
# Origen de los enlaces: HTTP solo loopback con NODE_ENV=development (http://localhost:3000).
# En producción HTTPS obligatorio. Debe apuntar a la misma instancia y base de registro.
TRANSACTIONAL_PUBLIC_ORIGIN=
